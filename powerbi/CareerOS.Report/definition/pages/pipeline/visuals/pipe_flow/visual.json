{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "pipe_flow",
  "position": {
    "x": 10,
    "y": 10,
    "z": 0,
    "width": 520,
    "height": 290,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "dim_date.date",
              "nativeQueryRef": "date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Jobs Discovered"
                }
              },
              "queryRef": "_Measures.Jobs Discovered",
              "nativeQueryRef": "Jobs Discovered"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Jobs Decided"
                }
              },
              "queryRef": "_Measures.Jobs Decided",
              "nativeQueryRef": "Jobs Decided"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Jobs Closed"
                }
              },
              "queryRef": "_Measures.Jobs Closed",
              "nativeQueryRef": "Jobs Closed"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Jobs in and out by day'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
