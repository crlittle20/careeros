{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "exec_sources",
  "position": {
    "x": 640,
    "y": 450,
    "z": 0,
    "width": 630,
    "height": 260,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_source"
                    }
                  },
                  "Property": "source_name"
                }
              },
              "queryRef": "dim_source.source_name",
              "nativeQueryRef": "source_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Jobs Qualified"
                }
              },
              "queryRef": "_Measures.Jobs Qualified",
              "nativeQueryRef": "Jobs Qualified"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Where qualified jobs come from'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
