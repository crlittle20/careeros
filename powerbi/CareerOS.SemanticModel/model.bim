    "expressions": [
      {
        "name": "ExportFolder",
        "kind": "m",
        "lineageTag": "83fd53af-a1c6-5036-ba00-3c4aa2198048",
        "expression": "\"C:\\CareerOS\\samples\\analytics_demo\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "LoadTable",
        "kind": "m",
        "lineageTag": "7793c3df-da04-5c93-99ba-37eadf90d7ee",
        "expression": [
          "(name as text) as table =>",
          "let",
          "    Source = Csv.Document(File.Contents(ExportFolder & \"\\\" & name & \".csv\"),",
          "                          [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
          "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
          "    NoMark = Table.TransformColumnNames(Headers, each Text.Replace(_, Character.FromNumber(65279), \"\")),",
          "    Nulls = Table.ReplaceValue(NoMark, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(NoMark))",
          "in",
          "    Nulls"
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"ExportFolder\", \"LoadTable\", \"dim_date\", \"dim_employer\", \"dim_board\", \"dim_ats\", \"dim_source\", \"dim_role_family\", \"dim_location\", \"dim_job\", \"fact_job_evaluation\", \"fact_job_observation\", \"fact_board_scan\", \"fact_verification\", \"fact_application\", \"_Measures\"]"
      }
    ]
  }
