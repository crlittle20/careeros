            "lineageTag": "53d2287e-7144-54dd-b8c6-c4c70051bdf1",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [Placeholder = text], {})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Jobs Discovered",
            "expression": "COUNTROWS ( fact_job_evaluation )",
            "formatString": "#,0",
            "lineageTag": "0f50a075-c953-5925-af43-fd4850365e5d"
          },
          {
            "name": "Distinct Openings",
            "expression": "CALCULATE ( [Jobs Discovered], fact_job_evaluation[is_duplicate] = 0, fact_job_evaluation[is_variant] = 0 )",
            "formatString": "#,0",
            "lineageTag": "6dbb44fd-e948-5ee7-a434-2f40eace35d2"
          },
          {
            "name": "Jobs Evaluated",
            "expression": "SUM ( fact_job_evaluation[is_evaluated] )",
            "formatString": "#,0",
            "lineageTag": "f39b6cd3-c7bf-51f7-9b3e-ab99ea5e77ce"
          },
          {
            "name": "Jobs Qualified",
            "expression": "SUM ( fact_job_evaluation[is_qualified] )",
            "formatString": "#,0",
            "lineageTag": "c8cec443-5a12-5d03-ac1e-29fd4b728589"
          },
          {
            "name": "Jobs Recommended",
            "expression": "SUM ( fact_job_evaluation[is_recommended] )",
            "formatString": "#,0",
            "lineageTag": "90d6581a-ff99-5214-8411-6f048577ba2f"
          },
          {
            "name": "Jobs Rejected",
            "expression": "SUM ( fact_job_evaluation[is_rejected] )",
            "formatString": "#,0",
            "lineageTag": "5c00b2a1-979f-5f0e-8b8b-570fc08a78ee"
          },
          {
            "name": "Jobs Manual Review",
            "expression": "SUM ( fact_job_evaluation[is_manual_review] )",
            "formatString": "#,0",
            "lineageTag": "8b64e5b9-01d3-56c8-b4f5-c2bcf4860a25"
          },
          {
            "name": "Manual Review Rate",
            "expression": "DIVIDE ( [Jobs Manual Review], [Jobs Evaluated] )",
            "formatString": "0.0%",
            "lineageTag": "e9bf8bb3-786d-5661-beb7-a14238bf8ea2"
          },
          {
            "name": "Duplicates Prevented",
            "expression": "SUM ( fact_job_evaluation[is_duplicate] ) + SUM ( fact_job_evaluation[linked_openings] )",
            "formatString": "#,0",
            "lineageTag": "92bc2deb-76ff-595c-964b-776c5350d1eb"
          },
          {
            "name": "Cross-Source Sightings",
            "expression": "SUM ( fact_job_observation[is_cross_source] )",
            "formatString": "#,0",
            "lineageTag": "d2d6d231-7e56-529a-90a3-1eabd73defd2"
          },
          {
            "name": "Verified Employers",
            "expression": "CALCULATE ( COUNTROWS ( dim_employer ), dim_employer[is_verified_employer] = 1 )",
            "formatString": "#,0",
            "lineageTag": "edea9602-ed9c-5853-a062-5c1106c61fa1"
          },
          {
            "name": "Average Fit",
            "expression": "CALCULATE ( AVERAGE ( fact_job_evaluation[candidate_fit] ), fact_job_evaluation[is_scored] = 1 )",
            "formatString": "0.0",
            "lineageTag": "f4516d94-0659-529c-a0ec-9b0982ae6a96"
          },
          {
            "name": "Board Verification Rate",
            "expression": [
              "VAR Judged =",
              "    CALCULATETABLE (",
              "        dim_board,",
              "        dim_board[collection] = \"allowed\",",
              "        NOT dim_board[verification_status] IN { \"historical\", \"retired\" }",
              "    )",
              "RETURN",
              "    DIVIDE ( COUNTROWS ( FILTER ( Judged, dim_board[verification_status] = \"active\" ) ), COUNTROWS ( Judged ) )"
            ],
            "formatString": "0.0%",
            "lineageTag": "81a97194-b865-5a27-af0f-6e1bbaa193b0"
          },
          {
            "name": "New-Board Verification Rate",
            "expression": [
              "VAR NewBoards = CALCULATETABLE ( dim_board, dim_board[is_legacy] = 0, dim_board[collection] = \"allowed\" )",
              "RETURN",
              "    DIVIDE (",
              "        COUNTROWS ( FILTER ( NewBoards, dim_board[verification_status] IN { \"quarantined\", \"active\" } ) ),",
              "        COUNTROWS ( NewBoards )",
              "    )"
            ],
            "formatString": "0.0%",
            "lineageTag": "7ce194ec-fee4-51b6-9de2-a8633d904315"
          },
          {
            "name": "Scan Reliability",
            "expression": "DIVIDE ( SUM ( fact_board_scan[is_complete] ), COUNTROWS ( fact_board_scan ) )",
            "formatString": "0.0%",
            "lineageTag": "9df59b22-f8f1-5000-8175-fcff2c250f7e"
          },
          {
            "name": "NIGHT Routed",
            "expression": "CALCULATE ( [Jobs Discovered], fact_job_evaluation[night_decision] = \"eligible\" )",
            "formatString": "#,0",
            "lineageTag": "c752b158-8f51-5917-989a-8f005ceede54"
          },
          {
            "name": "Applications",
            "expression": "COUNTROWS ( fact_application )",
            "formatString": "#,0",
            "lineageTag": "092f49b1-130d-5169-ad07-7b848fe1d1f8"
          },
          {
            "name": "Open Applications",
            "expression": "SUM ( fact_application[is_open] )",
            "formatString": "#,0",
            "lineageTag": "1b77ba10-de9f-5585-8f3e-e2dd45ba36ad"
          },
          {
            "name": "Interview Rate",
            "expression": "DIVIDE ( SUM ( fact_application[reached_interview] ), [Applications] )",
            "formatString": "0.0%",
            "lineageTag": "7e838582-5895-593a-b2ae-679e72c4f298"
          },
          {
            "name": "Qualified Rate",
            "expression": "DIVIDE ( [Jobs Qualified], [Jobs Evaluated] )",
            "formatString": "0.0%",
            "lineageTag": "50040f11-7194-5696-ad87-dbf4b7fb9e0c"
          },
          {
            "name": "Rejection Rate",
            "expression": "DIVIDE ( [Jobs Rejected], [Jobs Evaluated] )",
            "formatString": "0.0%",
            "lineageTag": "2b3224f5-c05b-541a-8ad4-ad7b2c8e25fe"
          },
          {
            "name": "Recommended Rate",
            "expression": "DIVIDE ( [Jobs Recommended], [Jobs Evaluated] )",
            "formatString": "0.0%",
            "lineageTag": "24e16442-8906-51eb-a577-6b100792a3be"
          },
          {
            "name": "Jobs Decided",
            "expression": "CALCULATE ( [Jobs Evaluated], USERELATIONSHIP ( fact_job_evaluation[decided_date_key], dim_date[date_key] ) )",
            "formatString": "#,0",
            "lineageTag": "b172c0a0-4af7-5c4a-9bdc-edbb5aeaa7ea"
          },
          {
            "name": "Jobs Closed",
            "expression": [
              "CALCULATE ( SUM ( fact_job_evaluation[is_closed] ),",
              "            USERELATIONSHIP ( fact_job_evaluation[closed_date_key], dim_date[date_key] ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "bd0f7295-fa8e-5bc0-96c6-16e29e4a3d5f"
          },
          {
            "name": "Jobs Labelled",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_job_evaluation ), NOT ISBLANK ( fact_job_evaluation[label] ),",
              "            USERELATIONSHIP ( fact_job_evaluation[label_date_key], dim_date[date_key] ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "d6f09f51-64c2-5cc8-b3d6-dae78873df64"
          },
          {
            "name": "Average Days to Decision",
            "expression": "AVERAGE ( fact_job_evaluation[days_to_decision] )",
            "formatString": "0.0",
            "lineageTag": "8b249b4a-3ae1-58c1-89f7-bd7acef9c3ca"
          },
          {
            "name": "Average Days Listed",
            "expression": "AVERAGE ( fact_job_evaluation[days_listed] )",
            "formatString": "0.0",
            "lineageTag": "d65ee1e5-ce1a-51ad-983a-e001abc7b467"
          },
          {
            "name": "Pay Stated Rate",
            "expression": "DIVIDE ( CALCULATE ( [Jobs Discovered], dim_job[is_pay_stated] = 1 ), [Jobs Discovered] )",
            "formatString": "0.0%",
            "lineageTag": "824a2d1e-28c9-5c40-8d1f-f7479071fcf6"
          },
          {
            "name": "Average Top of Pay Range (annual)",
            "expression": "CALCULATE ( AVERAGEX ( fact_job_evaluation, RELATED ( dim_job[annual_pay_max] ) ), fact_job_evaluation[is_scored] = 1 )",
            "formatString": "$#,0",
            "lineageTag": "32cee86f-fc2e-574d-baf6-6c61b3650cb2"
          },
          {
            "name": "Labelled Apply",
            "expression": "CALCULATE ( [Jobs Discovered], fact_job_evaluation[label] = \"apply\" )",
            "formatString": "#,0",
            "lineageTag": "7a74f8fb-22f5-5811-9b8f-fa753c2cdd55"
          },
          {
            "name": "Applied",
            "expression": "SUM ( fact_job_evaluation[has_application] )",
            "formatString": "#,0",
            "lineageTag": "2c6708e7-550c-50b5-b19e-a6db7dd03dc1"
          },
          {
            "name": "Recommended Then Applied",
            "expression": "CALCULATE ( [Applied], fact_job_evaluation[is_recommended] = 1 )",
            "formatString": "#,0",
            "lineageTag": "defe59b5-d378-5563-b60a-4846054c7e21"
          },
          {
            "name": "Response Rate",
            "expression": "DIVIDE ( SUM ( fact_application[got_answer] ), [Applications] )",
            "formatString": "0.0%",
            "lineageTag": "75f5012d-4fd0-565c-baea-e1f815667405"
          },
          {
            "name": "Screening Rate",
            "expression": "DIVIDE ( SUM ( fact_application[reached_screening] ), [Applications] )",
            "formatString": "0.0%",
            "lineageTag": "541eb8d3-3a34-5663-906c-496d63814311"
          },
          {
            "name": "Offer Rate",
            "expression": "DIVIDE ( SUM ( fact_application[reached_offer] ), [Applications] )",
            "formatString": "0.0%",
            "lineageTag": "80349c7c-7312-593d-b39d-64b548872d09"
          },
          {
            "name": "Average Board Trust",
            "expression": "AVERAGE ( dim_board[board_trust_score] )",
            "formatString": "0.0",
            "lineageTag": "604272b2-fa97-5ef6-af2b-85fa213c3a34"
          },
          {
            "name": "Scan Failures",
            "expression": "SUM ( fact_board_scan[is_failure] )",
            "formatString": "#,0",
            "lineageTag": "86f7c5a2-08db-5f2e-a0a8-431bd827456d"
          },
          {
            "name": "Postings Read",
            "expression": "SUM ( fact_board_scan[postings] )",
            "formatString": "#,0",
            "lineageTag": "2016ce1d-5e8d-57b1-bfad-291eb1afc80c"
          },
          {
            "name": "Verification Runs",
            "expression": "COUNTROWS ( fact_verification )",
            "formatString": "#,0",
            "lineageTag": "fb91a860-4611-5b99-ab08-80ebdf43c999"
          },
          {
            "name": "Verification Pass Rate",
            "expression": "DIVIDE ( SUM ( fact_verification[is_pass] ), [Verification Runs] )",
            "formatString": "0.0%",
            "lineageTag": "d92809c5-d9c7-507c-b5bc-48aafaf7f8e7"
          },
          {
            "name": "Remote Nationwide Share",
            "expression": "DIVIDE ( CALCULATE ( [Jobs Discovered], dim_location[remote_scope] = \"US_nationwide\" ), [Jobs Discovered] )",
            "formatString": "0.0%",
            "lineageTag": "cf59abde-8c9a-5271-bbb9-a14a31273a30"
          },
          {
            "name": "Boards",
            "expression": "CALCULATE ( COUNTROWS ( dim_board ), dim_board[board_key] <> \"(none)\" )",
            "formatString": "#,0",
            "lineageTag": "2408d8c0-2ef7-5593-ac0d-09d3b5e4b20f"
          },
          {
            "name": "Average Career Fit",
            "expression": "AVERAGE ( dim_employer[career_fit_score] )",
            "formatString": "0.0",
            "lineageTag": "de17d381-a18c-5734-928b-82753ff18ff7"
          },
          {
            "name": "Shortlist Jobs",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_job_evaluation ),",
              "            fact_job_evaluation[is_recommended] = 1 || fact_job_evaluation[is_manual_review] = 1 )"
            ],
            "formatString": "#,0",
            "lineageTag": "c8b25e64-0159-5dc8-a64d-1000c1ef7c15"
          },
          {
            "name": "Jobs Rejected by Reason",
            "expression": [
              "IF ( HASONEVALUE ( fact_job_evaluation[rejection_group] ) && ISBLANK ( SELECTEDVALUE ( fact_job_evaluation[rejection_group] ) ),",
              "     BLANK (), [Jobs Rejected] )"
            ],
            "formatString": "#,0",
            "lineageTag": "dd93ac2a-0670-5447-ae00-eaa49170fb96"
          },
          {
            "name": "Scan Failures by Error",
            "expression": [
              "IF ( HASONEVALUE ( fact_board_scan[error_code] ) && ISBLANK ( SELECTEDVALUE ( fact_board_scan[error_code] ) ),",
              "     BLANK (), [Scan Failures] )"
            ],
            "formatString": "#,0",
            "lineageTag": "b53307ce-111f-5522-b44e-fb4a5cd7851c"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
