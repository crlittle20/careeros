{
  "workflow": "application",
  "contract_version": "0.2.0",
  "notes": "acknowledged = an automatic confirmation (never a recruiter response); responded = a real person replied (prompts v2.2); accepted = hired; closed = the posting was closed or filled without a decision",
  "states": {
    "applied": "active",
    "acknowledged": "active",
    "responded": "active",
    "screening": "active",
    "interviewing": "active",
    "final_interview": "active",
    "offer": "active",
    "ghosted": "blocked",
    "accepted": "completed",
    "declined": "cancelled",
    "rejected": "cancelled",
    "withdrawn": "cancelled",
    "closed": "cancelled"
  },
  "initial_state": "applied",
  "terminal": ["accepted", "declined", "rejected", "withdrawn", "closed"],
  "allowed": [
    {"from": "applied", "to": "acknowledged"}, {"from": "applied", "to": "responded"}, {"from": "applied", "to": "screening"},
    {"from": "applied", "to": "interviewing"}, {"from": "applied", "to": "rejected"}, {"from": "applied", "to": "withdrawn"},
    {"from": "applied", "to": "ghosted"}, {"from": "applied", "to": "closed"},
    {"from": "acknowledged", "to": "responded"}, {"from": "acknowledged", "to": "screening"}, {"from": "acknowledged", "to": "interviewing"},
    {"from": "acknowledged", "to": "rejected"}, {"from": "acknowledged", "to": "withdrawn"}, {"from": "acknowledged", "to": "ghosted"},
    {"from": "acknowledged", "to": "closed"},
    {"from": "responded", "to": "screening"}, {"from": "responded", "to": "interviewing"}, {"from": "responded", "to": "rejected"},
    {"from": "responded", "to": "withdrawn"}, {"from": "responded", "to": "ghosted"}, {"from": "responded", "to": "closed"},
    {"from": "screening", "to": "interviewing"}, {"from": "screening", "to": "offer"}, {"from": "screening", "to": "rejected"},
    {"from": "screening", "to": "withdrawn"}, {"from": "screening", "to": "ghosted"}, {"from": "screening", "to": "closed"},
    {"from": "interviewing", "to": "final_interview"}, {"from": "interviewing", "to": "offer"},
    {"from": "interviewing", "to": "rejected"}, {"from": "interviewing", "to": "withdrawn"}, {"from": "interviewing", "to": "ghosted"},
    {"from": "interviewing", "to": "closed"},
    {"from": "final_interview", "to": "offer"}, {"from": "final_interview", "to": "rejected"},
    {"from": "final_interview", "to": "withdrawn"}, {"from": "final_interview", "to": "ghosted"}, {"from": "final_interview", "to": "closed"},
    {"from": "offer", "to": "accepted"}, {"from": "offer", "to": "declined"}, {"from": "offer", "to": "withdrawn"},
    {"from": "ghosted", "to": "acknowledged"}, {"from": "ghosted", "to": "responded"}, {"from": "ghosted", "to": "screening"},
    {"from": "ghosted", "to": "interviewing"}, {"from": "ghosted", "to": "rejected"}, {"from": "ghosted", "to": "withdrawn"},
    {"from": "ghosted", "to": "closed"}
  ],
  "self_transitions": false
}
