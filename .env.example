# CareerOS environment variables. None is required for normal use.
#
# CareerOS does not read .env files itself: set these in your shell or in the scheduled task if you need them.
# NEVER put a secret in a file. Credentials live in Windows Credential Manager (see SECURITY.md):
#   CareerOS/gmail        Gmail OAuth refresh token (written by `careeros gmail connect`)
#   CareerOS/gmail-imap   Gmail app password (stored by you with cmdkey)
#   CareerOS/anthropic    Anthropic API key (optional AI requirement reading)

# Where your private vault lives. Default: a folder named "vault" next to this repository.
# It must be outside the repository; CareerOS refuses to run otherwise.
CAREEROS_VAULT=C:\path\to\CareerOS\vault

# Demo Mode: synthetic, offline and credential-free (docs/demo_mode.md). true / 1 / yes / on to switch it on.
CAREEROS_DEMO_MODE=false

# Where the throwaway demo vault lives. Default: %TEMP%\careeros-demo-vault
CAREEROS_DEMO_VAULT=

# Optional, and only if you do not use Credential Manager (preferred). Leave empty in any file you might share.
ANTHROPIC_API_KEY=
